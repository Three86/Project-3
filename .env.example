# Copy to .env and adjust.
# Path to the game's Logs folder (forward slashes work on Windows with Docker Desktop).
EFT_LOGS_PATH=C:/Battlestate Games/EFT/Logs
# regular = PvP, pve = PvE
GAME_MODE=regular
TRACKER_PORT=3000
# Re-download quest/hideout data from tarkov.dev when the cache is older than this (0 = never).
REFRESH_HOURS=24
